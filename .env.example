# ---------- Core ----------
DATABASE_URL=postgresql+psycopg2://foundit_user:your_password@localhost:5432/foundit_db
SECRET_KEY=your_secret_key
FRONTEND_URL=http://localhost:5173
# Set to true when the site is served over HTTPS (production)
SESSION_COOKIE_SECURE=false

# ---------- Google sign-in ----------
GOOGLE_CLIENT_ID=your_google_client_id

# ---------- Email ----------
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_SENDER_EMAIL=your_sender_email@gmail.com

# When test mode is true, every email is sent to OTP_TEST_EMAIL instead of the real user
OTP_TEST_MODE=false
OTP_TEST_EMAIL=your_test_email@example.com

# ---------- Email change (SMTP) ----------
EMAIL_CHANGE_SMTP_HOST=smtp.example.com
EMAIL_CHANGE_SMTP_PORT=587
EMAIL_CHANGE_SMTP_USER=your_smtp_user
EMAIL_CHANGE_SMTP_PASSWORD=your_smtp_password
EMAIL_CHANGE_FROM=FoundIt <no-reply@example.com>

# ---------- M-Pesa tips (sandbox) ----------
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_CALLBACK_URL=https://your-backend-url/your-callback-path
